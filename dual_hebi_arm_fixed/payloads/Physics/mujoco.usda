        def MjcActuator "left_J1_base_actuator"
        {
            uniform double mjc:forceRange:max = 20
            uniform double mjc:forceRange:min = -20
            custom rel mjc:target
            append rel mjc:target = </dual_hebi_arm/Physics/left_J1_base>
        }

