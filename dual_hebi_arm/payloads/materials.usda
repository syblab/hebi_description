        )

        def Shader "PreviewSurface" (
            apiSchemas = ["NodeDefAPI"]
        )
        {
            token info:id = "UsdPreviewSurface"
            prepend color3f inputs:diffuseColor.connect = </Materials/beige.inputs:diffuseColor>
            prepend float inputs:metallic.connect = </Materials/beige.inputs:metallic>
            prepend float inputs:opacity.connect = </Materials/beige.inputs:opacity>
