            point3f physics:localPos0 = (0, 0, -1.3877788e-17)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -1
            float physics:upperLimit = 1
            custom float urdf:limit:effort = 1000

            def Scope "physics"
            {
                def Scope "ode"
                {
                    def Scope "implicit_spring_damper"
                    {
                        custom string urdf:text = "true"
                    }
                }
            }
        }

