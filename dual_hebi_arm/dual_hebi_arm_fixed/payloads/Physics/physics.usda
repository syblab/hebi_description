#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "dual_hebi_arm"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

over "dual_hebi_arm"
{
    over "Physics"
    {
        def PhysicsPrismaticJoint "left_end_effector_1_center_hub_pinion" (
            prepend apiSchemas = ["NewtonJointAPI", "NewtonMimicAPI", "PhysicsDriveAPI:linear", "PhysicsJointStateAPI:linear"]
        )
        {
            float drive:linear:physics:maxForce = 1000
            float newton:mimicCoef1 = 0.00001
            rel newton:mimicJoint = </dual_hebi_arm/Physics/left_end_effector_1_input_l_finger>
            float newton:velocityLimit = 1000
            uniform token physics:axis = "Z"
            custom rel physics:body0
            append rel physics:body0 = </dual_hebi_arm/Geometry/world/left_base_link/left_J1_base_body/left_bracket_1/left_J2_shoulder_body/left_link_1/left_J3_elbow_body/left_link_2/left_J4_wrist1_body/left_bracket_2/left_J5_wrist2_body/left_bracket_3/left_J6_wrist3_body/left_end_effector_1/left_end_effector_1_center_hub>
