    def Xform "X8" (
        prepend references = @./geometries.usd@</Geometries/X8>
    )
    {
        over "X8" (
            apiSchemas = ["MaterialBindingAPI"]
        )
        {
            custom rel material:binding
            prepend rel material:binding = </Instances/X8/VisualMaterials/red>
        }

        def Scope "VisualMaterials"
        {
            def Material "red" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/red>
            )
            {
            }
        }
    }

    def Xform "X8_1" (
        prepend references = @./geometries.usd@</Geometries/X8>
    )
    {
        over "X8" (
