<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="A-2085-06G-dual">

  <xacro:arg name="config_pkg" default="" />
  <xacro:arg name="config_file" default="" />
  <xacro:arg name="prefix" default="" />
  <xacro:arg name="use_mock_hardware" default="false" />
  <xacro:arg name="mock_sensor_commands" default="false" />
  <xacro:arg name="sim_gazebo" default="false" />

  <xacro:include filename="$(find hebi_description)/urdf/kits/ros2_control/A-2085-06G.ros2_control.xacro" />
  <xacro:include filename="$(find hebi_description)/urdf/kits/A-2085-06G.urdf.xacro" />

  <link name="world"/>

  <link name="left_mount_link"/>
  <link name="right_mount_link"/>

  <joint name="world_to_left_mount" type="fixed">
    <parent link="world"/>
    <child link="left_mount_link"/>
    <origin xyz="0 0.35 0" rpy="0 0 0"/>
  </joint>

  <joint name="world_to_right_mount" type="fixed">
    <parent link="world"/>
    <child link="right_mount_link"/>
    <origin xyz="0 -0.35 0" rpy="0 0 0"/>
  </joint>

  <!-- geometry include #1 -->
  <xacro:property name="prefix" value="left_"/>
  <xacro:include filename="$(find hebi_description)/urdf/kits/A-2085-06G.urdf.xacro"/>

  <joint name="left_mount_to_base_joint" type="fixed">
    <parent link="left_mount_link"/>
    <child link="left_base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <xacro:A-2085-06G_ros2_control
    name="left_A_2085_06G"
    prefix="left_"
    use_mock_hardware="$(arg use_mock_hardware)"
    mock_sensor_commands="$(arg mock_sensor_commands)"
    sim_gazebo="$(arg sim_gazebo)"
    config_pkg="$(arg config_pkg)"
    config_file="$(arg config_file)" />

  <!-- geometry include #2 -->
  <xacro:property name="prefix" value="right_"/>
  <xacro:include filename="$(find hebi_description)/urdf/kits/A-2085-06G.urdf.xacro"/>

  <joint name="right_mount_to_base_joint" type="fixed">
    <parent link="right_mount_link"/>
    <child link="right_base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <xacro:A-2085-06G_ros2_control
    name="right_A_2085_06G"
    prefix="right_"
    use_mock_hardware="$(arg use_mock_hardware)"
    mock_sensor_commands="$(arg mock_sensor_commands)"
    sim_gazebo="$(arg sim_gazebo)"
    config_pkg="$(arg config_pkg)"
    config_file="$(arg config_file)" />

</robot>