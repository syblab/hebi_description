<?xml version="1.0" encoding="UTF-8"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- A-2085-06G ros2_control macro -->

  <xacro:macro
    name="A-2085-06G_ros2_control"
    params="
      name
      prefix
      use_mock_hardware:=^|false
      mock_sensor_commands:=^|false
      sim_gazebo:=^|false
      use_gripper:=^|true
      config_pkg
      config_file
    "
  >

    <ros2_control name="${name}" type="system">

      <hardware>

        <!-- Mock hardware -->
        <xacro:if value="${use_mock_hardware}">
          <!-- 実機用ドライバを一時的にコメントアウト -->
          <!-- <plugin>gz_ros2_control/GazeboSimSystem</plugin> -->
        
          <!-- シミュレーション用ドライバを追加 -->
          <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        
          <!-- 以下の param などはそのまま残す -->
          <param name="mock_sensor_commands">
            ${mock_sensor_commands}
          </param>
        </xacro:if>

        <!-- Gazebo hardware -->
        <xacro:if value="${sim_gazebo}">
          <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </xacro:if>

        <!-- Real HEBI hardware -->
        <xacro:unless value="${use_mock_hardware or sim_gazebo}">

          <param name="config_pkg">
            ${config_pkg}
          </param>

          <param name="config_file">
            ${config_file}
          </param>

          <!-- Gripper configuration -->
          <xacro:if value="${use_gripper}">
            <param name="gripper_joint_name">
              ${prefix}end_effector_1/input_l_finger
            </param>
          </xacro:if>

          <plugin>gz_ros2_control/GazeboSimSystem</plugin>

        </xacro:unless>

      </hardware>

      <!-- Joint 1 -->
      <joint name="${prefix}J1_base">

        <command_interface name="position" />
        <command_interface name="velocity" />

        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>

        <state_interface name="velocity">
          <param name="initial_value">0.0</param>
        </state_interface>

      </joint>

      <!-- Joint 2 -->
      <joint name="${prefix}J2_shoulder">

        <command_interface name="position" />
        <command_interface name="velocity" />

        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>

        <state_interface name="velocity">
          <param name="initial_value">0.0</param>
        </state_interface>

      </joint>

      <!-- Joint 3 -->
      <joint name="${prefix}J3_elbow">

        <command_interface name="position" />
        <command_interface name="velocity" />

        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>

        <state_interface name="velocity">
          <param name="initial_value">0.0</param>
        </state_interface>

      </joint>

      <!-- Joint 4 -->
      <joint name="${prefix}J4_wrist1">

        <command_interface name="position" />
        <command_interface name="velocity" />

        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>

        <state_interface name="velocity">
          <param name="initial_value">0.0</param>
        </state_interface>

      </joint>

      <!-- Joint 5 -->
      <joint name="${prefix}J5_wrist2">

        <command_interface name="position" />
        <command_interface name="velocity" />

        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>

        <state_interface name="velocity">
          <param name="initial_value">0.0</param>
        </state_interface>

      </joint>

      <!-- Joint 6 -->
      <joint name="${prefix}J6_wrist3">

        <command_interface name="position" />
        <command_interface name="velocity" />

        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>

        <state_interface name="velocity">
          <param name="initial_value">0.0</param>
        </state_interface>

      </joint>

      <!-- Gripper joint -->
      <xacro:if value="${use_gripper}">

        <joint name="${prefix}end_effector_1/input_l_finger">

          <command_interface name="position" />
          <command_interface name="velocity" />

          <state_interface name="position">
            <param name="initial_value">0.0</param>
          </state_interface>

          <state_interface name="velocity">
            <param name="initial_value">0.0</param>
          </state_interface>

        </joint>

      </xacro:if>

    </ros2_control>

  </xacro:macro>

</robot>
