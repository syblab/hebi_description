<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="dual_hebi_arm">

  <!-- 先ほどマクロ化した物理モデルファイルと、コントローラファイルを読み込む -->
  <xacro:include filename="$(find hebi_description)/urdf/kits/A-2085-06G.urdf.xacro" />
  <xacro:include filename="$(find hebi_description)/urdf/kits/ros2_control/A-2085-06G.ros2_control.xacro" />


  <!-- Init colour -->
  <material name="grey">
      <color rgba="0.5 0.5 0.5 1"/>
  </material>

  <material name="blue">
      <color rgba="0 0 0.5 1"/>
  </material>

  <material name="green">
      <color rgba="0 0.5 0 1"/>
  </material>

  <material name="black">
      <color rgba="0 0 0 1"/>
  </material>


  <!-- 空間の基準となるリンク -->
  <link name="world" />

  <!-- ロボットの「基準点（base_link）」を地面（床面）に垂直に投影した仮想的なリンク（座標系） -->
  <!-- base_link and base_footprint -->
  <joint name="base_footprint_joint" type="fixed">
      <parent link="world"/>
      <child link="base_footprint"/>
      <origin xyz="0.0 0.0 0.06" rpy="0 0 0"/>
  </joint>

  <link name="base_footprint" />


  <!-- base_link and base_footprint -->
  <joint name="base_joint" type="fixed">
      <parent link="base_footprint"/>
      <child link="base_link"/>
      <origin xyz="0.0 0.0 0.12" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
      <visual>
          <geometry>
              <cylinder radius="0.2725" length="0.24" />
          </geometry>
          <origin xyz="0 0 0.0" rpy="0 0 0" />
          <material name="black" />
      </visual>
  </link>

  <!-- base_link and vertical_bar_left_link -->
  <joint name="vertical_bar_left_joint" type="fixed">
    <parent link="base_link"/>
    <child link="vertical_bar_left_link"/>
    <origin xyz="-0.1225 0.06 0.245" rpy="0 0 0"/> <!--0.12 + 0.125--><!--0.2725 - 0.15-->
  </joint>

  <link name="vertical_bar_left_link">
    <visual>
      <geometry>
        <box size="0.05 0.05 0.25"/>
      </geometry>
      <material name="black" />
    </visual>
  </link>

  <!-- base_link and vertical_bar_right_link -->
  <joint name="vertical_bar_right_joint" type="fixed">
    <parent link="base_link"/>
    <child link="vertical_bar_right_link"/>
    <origin xyz="-0.1225 -0.06 0.245" rpy="0 0 0"/> <!--0.12 + 0.125-->
  </joint>

  <link name="vertical_bar_right_link">
    <visual>
      <geometry>
        <box size="0.05 0.05 0.25"/>
      </geometry>
      <material name="black" />
    </visual>
  </link>

  <!-- vertical_bar_right_link to horizontal_bar_joint -->
  <joint name="horizontal_bar_joint" type="fixed">
    <parent link="vertical_bar_right_link"/>
    <child link="horizontal_bar_link"/>
    <origin xyz="0.0 0.06 0.15" rpy="0 1.57 1.57"/><!--0.025 + 0.125-->
  </joint>

  <link name="horizontal_bar_link">
    <visual>
      <geometry>
        <box size="0.05 0.05 0.445"/>
      </geometry>
      <material name="black" />
    </visual>
  </link>

  <!-- vertical_bar2_left_link -->
  <joint name="vertical_bar2_left_joint" type="fixed">
    <parent link="horizontal_bar_link"/>
    <child link="vertical_bar2_left_link"/>
    <origin xyz="-0.23 0.0 0.06" rpy="0 1.57 0"/>
  </joint>

  <link name="vertical_bar2_left_link">
    <visual>
      <geometry>
        <box size="0.05 0.05 0.41"/>
      </geometry>
      <material name="black" />
    </visual>
  </link>

  <!-- vertical_bar2_right_link -->
  <joint name="vertical_bar2_right_joint" type="fixed">
    <parent link="horizontal_bar_link"/>
    <child link="vertical_bar2_right_link"/>
    <origin xyz="-0.23 0.0 -0.06" rpy="0 1.57 0"/><!---0.21-->
  </joint>

  <link name="vertical_bar2_right_link">
    <visual>
      <geometry>
        <box size="0.05 0.05 0.41"/>
      </geometry>
      <material name="black" />
    </visual>
  </link>

  <!-- horizontal_left_bar_link -->
  <joint name="horizontal_left_bar_joint" type="fixed">
    <parent link="vertical_bar2_left_link"/>
    <child link="horizontal_left_bar_link"/>
    <origin xyz="0.0 -0.165 -0.0505" rpy="0 1.57 1.57"/>
  </joint>

  <link name="horizontal_left_bar_link">
    <visual>
      <geometry>
        <box size="0.05 0.05 0.28"/>
      </geometry>
      <material name="black" />
    </visual>
  </link>

  <!-- horizontal_right_bar_link -->
  <joint name="horizontal_right_bar_joint" type="fixed">
    <parent link="vertical_bar2_right_link"/>
    <child link="horizontal_right_bar_link"/>
    <origin xyz="0.0 -0.165 -0.0505" rpy="0 1.57 1.57"/>
  </joint>

  <link name="horizontal_right_bar_link">
    <visual>
      <geometry>
        <box size="0.05 0.05 0.28"/>
      </geometry>
      <material name="black" />
    </visual>
  </link>

  <!-- ================= 左手 (Left Arm) ================= -->
  <!-- 左手ベースの位置と向き（例: Y軸方向に+30cm） -->
  <joint name="world_to_left_base" type="fixed">
    <origin xyz="0 0.13 0" rpy="0 0 -1.75" /> 
    <parent link="world" />
    <child link="left_base_link" />
  </joint>

  <xacro:hebi_arm_A_2085_06G prefix="left_" />
  <xacro:A-2085-06G_ros2_control 
    name="LeftArmSystem" 
    prefix="left_" 
    use_mock_hardware="true" 
    config_pkg="hebi_description" 
    config_file="config/arms/A-2085-06G.cfg.yaml" />

  <!-- ================= 右手 (Right Arm) ================= -->
  <!-- 右手ベースの位置と向き（例: Y軸方向に-30cm） -->
  <joint name="world_to_right_base" type="fixed">
    <origin xyz="0 0.0 0" rpy="0 0 0" /> 
    <parent link="world" />
    <child link="right_base_link" />
  </joint>

  <xacro:hebi_arm_A_2085_06G prefix="right_" />
  <xacro:A-2085-06G_ros2_control 
    name="RightArmSystem" 
    prefix="right_" 
    use_mock_hardware="true" 
    config_pkg="hebi_description" 
    config_file="config/arms/A-2085-06G.cfg.yaml" />

</robot>
