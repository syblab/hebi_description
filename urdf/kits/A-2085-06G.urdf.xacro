<?xml version='1.0' encoding='UTF-8'?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="A-2085-06G">

  <!-- 全体を hebi_arm_A_2085_06G という名前のマクロにする -->
  <xacro:macro name="hebi_arm_A_2085_06G" params="prefix">
    
    <!-- HEBI A-2085-06G Arm Kit -->
    <xacro:include filename="$(find hebi_description)/urdf/components/hebi.xacro"/>
    <link name="${prefix}base_link"/>
    
    <joint name="${prefix}base_joint" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="${prefix}base_link"/>
      <child link="${prefix}J1_base/body"/>
    </joint>
    
    <xacro:actuator type="X8_9" name="${prefix}J1_base" child="${prefix}bracket_1"/>
    <xacro:bracket type="X5HeavyRightOutside" name="${prefix}bracket_1"/>
    <xacro:output type="X5HeavyRightOutside" parent="${prefix}bracket_1" child="${prefix}J2_shoulder/body" name="${prefix}bracket_1_J2_shoulder"/>
    <xacro:actuator type="X8_16" name="${prefix}J2_shoulder" child="${prefix}link_1"/>
    <xacro:link type="X5" extension="0.325" twist="${pi}" name="${prefix}link_1" child="${prefix}J3_elbow/body"/>
    <xacro:actuator type="X8_9" name="${prefix}J3_elbow" child="${prefix}link_2"/>
    <xacro:link type="X5" extension="0.325" twist="${pi}" name="${prefix}link_2" child="${prefix}J4_wrist1/body"/>
    <xacro:actuator type="X5_1" name="${prefix}J4_wrist1" child="${prefix}bracket_2"/>
    <xacro:bracket type="X5LightRight" name="${prefix}bracket_2"/>
    <xacro:output type="X5LightRight" parent="${prefix}bracket_2" child="${prefix}J5_wrist2/body" name="${prefix}bracket_2_J5_wrist2"/>
    <xacro:actuator type="X5_1" name="${prefix}J5_wrist2" child="${prefix}bracket_3"/>
    <xacro:bracket type="X5LightRight" name="${prefix}bracket_3"/>
    <xacro:output type="X5LightRight" parent="${prefix}bracket_3" child="${prefix}J6_wrist3/body" name="${prefix}bracket_3_J6_wrist3"/>
    <xacro:actuator type="X5_1" name="${prefix}J6_wrist3" child="${prefix}end_effector_1"/>
    <xacro:gripper type="X5Parallel" name="${prefix}end_effector_1"/>

  </xacro:macro>
</robot>
