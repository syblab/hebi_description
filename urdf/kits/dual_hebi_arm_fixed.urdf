    <joint name="left_end_effector_1_finger_gearbox" type="gearbox">
      <parent>left_end_effector_1_r_finger</parent>
      <child>left_end_effector_1_l_finger</child>
      <gearbox_reference_body>left_end_effector_1</gearbox_reference_body>
      <gearbox_ratio>1</gearbox_ratio>
      <axis>
